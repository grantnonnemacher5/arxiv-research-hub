# Copy to `.env` in this directory (project root). Never commit `.env`.

# --- Database ---
# Omit DATABASE_URL to use SQLite (backend/research_hub.db).
#
# Local Postgres via Docker Compose (see docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://arxiv:arxiv_local_dev@127.0.0.1:5432/research_hub
#
# Production (Neon, Supabase, Railway): paste the connection string they give you.
# Often includes SSL, e.g. ?sslmode=require
# DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- App ---
OPENAI_API_KEY=
